@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-icon" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                <i class="fas fa-users"></i>
            </div>
            <h3>120</h3>
            <p>Total Students</p>
            <div class="card-trend">
                <i class="fas fa-arrow-up"></i> 12% from last month
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-icon" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                <i class="fas fa-door-open"></i>
            </div>
            <h3>45</h3>
            <p>Available Rooms</p>
            <div class="card-trend">
                <i class="fas fa-arrow-down"></i> 5% from last month
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-icon" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3>12</h3>
            <p>Pending Complaints</p>
            <div class="card-trend urgent">
                <i class="fas fa-exclamation-circle"></i> Needs attention
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-icon" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                <i class="fas fa-rupee-sign"></i>
            </div>
            <h3>Rs.52,000</h3>
            <p>Total Payments</p>
            <div class="card-trend">
                <i class="fas fa-arrow-up"></i> 8% from last month
            </div>
        </div>
    </div>
</div>

<!-- Additional Dashboard Content -->
<div class="row g-4">
    <div class="col-md-8">
        <div class="content-card">
            <div class="card-header-custom">
                <h4><i class="fas fa-chart-line"></i> Recent Activities</h4>
                <button class="btn-secondary btn-sm">View All</button>
            </div>
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-icon" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="activity-content">
                        <h5>New Student Registered</h5>
                        <p>Saad has been registered to Room 42</p>
                        <span class="activity-time">2 hours ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <div class="activity-content">
                        <h5>New Complaint Filed</h5>
                        <p>Room 21 - AC not working</p>
                        <span class="activity-time">4 hours ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="activity-content">
                        <h5>Payment Received</h5>
                        <p>Rs.5,000 received from Student ID #1234</p>
                        <span class="activity-time">6 hours ago</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card">
            <div class="card-header-custom">
                <h4><i class="fas fa-calendar-alt"></i> Today's Menu</h4>
            </div>
            <div class="menu-preview">
                <div class="menu-item">
                    <div class="menu-icon">🌅</div>
                    <div>
                        <h5>Breakfast</h5>
                        <p>Paratha, Chai, Omelette</p>
                    </div>
                </div>
                <div class="menu-item">
                    <div class="menu-icon">🌞</div>
                    <div>
                        <h5>Lunch</h5>
                        <p>Rice, Daal, Chicken Curry</p>
                    </div>
                </div>
                <div class="menu-item">
                    <div class="menu-icon">🌙</div>
                    <div>
                        <h5>Dinner</h5>
                        <p>Roti, Vegetables, Raita</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Additional styles for dashboard enhancements */
    .card-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

        .card-icon i {
            font-size: 28px;
            color: white;
        }

    .card-trend {
        margin-top: 12px;
        font-size: 13px;
        color: #48bb78;
        font-weight: 600;
    }

        .card-trend i {
            margin-right: 5px;
        }

        .card-trend.urgent {
            color: #f56565;
        }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

        .card-header-custom h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            color: #2d3748;
        }

        .card-header-custom i {
            margin-right: 10px;
            color: #667eea;
        }

    .btn-sm {
        padding: 8px 16px;
        font-size: 13px;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .activity-item {
        display: flex;
        gap: 15px;
        padding: 15px;
        background: rgba(102, 126, 234, 0.03);
        border-radius: 12px;
        transition: all 0.3s;
    }

        .activity-item:hover {
            background: rgba(102, 126, 234, 0.08);
            transform: translateX(5px);
        }

    .activity-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

        .activity-icon i {
            font-size: 20px;
            color: white;
        }

    .activity-content h5 {
        margin: 0 0 5px 0;
        font-size: 15px;
        font-weight: 600;
        color: #2d3748;
    }

    .activity-content p {
        margin: 0 0 8px 0;
        font-size: 14px;
        color: #718096;
    }

    .activity-time {
        font-size: 12px;
        color: #a0aec0;
        font-style: italic;
    }

    .menu-preview {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .menu-item {
        display: flex;
        gap: 15px;
        padding: 15px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
        border-radius: 12px;
        transition: all 0.3s;
    }

        .menu-item:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.15);
        }

    .menu-icon {
        font-size: 32px;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .menu-item h5 {
        margin: 0 0 5px 0;
        font-size: 15px;
        font-weight: 600;
        color: #2d3748;
    }

    .menu-item p {
        margin: 0;
        font-size: 13px;
        color: #718096;
    }
</style>