@model List<Complaint>
@{
    ViewData["Title"] = "Complaints Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-card">

    <!-- HEADER -->
    <div class="card-header-custom">
        <h4><i class="fas fa-exclamation-circle"></i> Complaints Management</h4>
    </div>

    <!-- NO COMPLAINTS MESSAGE -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert-info">
            <i class="fas fa-info-circle"></i> No complaints submitted yet.
        </div>
    }
    else
    {
        <!-- COMPLAINTS TABLE -->
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Student Name</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var complaint in Model)
                {
                    <tr>
                        <!-- ID -->
                        <td>@complaint.ComplaintID</td>

                        <!-- STUDENT NAME -->
                        <td>@complaint.StudentName</td>

                        <!-- TITLE -->
                        <td>@complaint.Title</td>

                        <!-- DESCRIPTION -->
                        <td>@complaint.Description</td>

                        <!-- TIME -->
                        <td>@complaint.Time.ToString("dd/MM/yyyy HH:mm")</td>

                        <!-- STATUS BADGE -->
                        <td>
                            @if (complaint.Status == "Pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (complaint.Status == "Received")
                            {
                                <span class="badge bg-info">Received</span>
                            }
                            else if (complaint.Status == "In Progress")
                            {
                                <span class="badge bg-primary">In Progress</span>
                            }
                            else if (complaint.Status == "Done")
                            {
                                <span class="badge bg-success">Done</span>
                            }
                        </td>

                        <!-- ACTION BUTTONS -->
                        <td class="action-buttons">

                            @* PENDING → can only mark as Received *@
                            @if (complaint.Status == "Pending")
                            {
                                <form asp-action="MarkReceived" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@complaint.ComplaintID" />
                                    <button type="submit" class="btn-edit">Received</button>
                                </form>
                            }

                            @* RECEIVED → can only mark as In Progress *@
                            else if (complaint.Status == "Received")
                            {
                                <form asp-action="MarkInProgress" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@complaint.ComplaintID" />
                                    <button type="submit" class="btn-view">In Progress</button>
                                </form>
                            }

                            @* IN PROGRESS → can only mark as Done *@
                            else if (complaint.Status == "In Progress")
                            {
                                <form asp-action="MarkDone" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@complaint.ComplaintID" />
                                    <button type="submit" class="btn-delete">Done</button>
                                </form>
                            }

                            @* DONE → no more status updates *@
                            else if (complaint.Status == "Done")
                            {
                                <span style="color: #10b981; font-weight: 600;">✔ Resolved</span>
                            }

                            <!-- VIEW DETAILS -->
                            <a asp-action="Details" asp-route-id="@complaint.ComplaintID" class="btn-view">
                                <i class="fas fa-eye"></i> View
                            </a>

                            <!-- DELETE -->
                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@complaint.ComplaintID" />
                                <button type="submit" class="btn-delete"
                                        onclick="return confirm('Are you sure you want to delete this complaint?')">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

<style>
    .content-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

        .card-header-custom h4 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #2d3748;
        }

        .card-header-custom i {
            margin-right: 10px;
            color: #667eea;
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .data-table thead tr {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .data-table th {
            padding: 14px 16px;
            text-align: left;
            font-weight: 600;
            font-size: 14px;
        }

        .data-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            color: #4a5568;
            vertical-align: middle;
        }

        .data-table tbody tr:hover {
            background: rgba(102, 126, 234, 0.04);
        }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .bg-warning  { background: #f59e0b; color: white; }
    .bg-info     { background: #3b82f6; color: white; }
    .bg-primary  { background: #8b5cf6; color: white; }
    .bg-success  { background: #10b981; color: white; }

    .action-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-edit {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-view {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-block;
    }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-edit:hover,
    .btn-view:hover,
    .btn-delete:hover {
        transform: translateY(-1px);
        opacity: 0.9;
    }

    .alert-info {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #3b82f6;
        padding: 15px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>