@model List<Complaint>
@{
    ViewData["Title"] = "My Complaints";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<!-- WHITE CARD -->
<div class="content-card">
    <div class="card-header-custom">
        <h4><i class="fas fa-exclamation-circle"></i> My Complaints</h4>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You have not submitted any complaints yet.
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var complaint in Model)
                {
                    <tr>
                        <td>@complaint.ComplaintID</td>
                        <td>@complaint.Title</td>
                        <td>@complaint.Description</td>
                        <td>@complaint.Time.ToString("g")</td>
                        <td>
                            @if (complaint.Status == "Pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (complaint.Status == "Received")
                            {
                                <span class="badge bg-info">Received</span>
                            }
                            else if (complaint.Status == "In Progress")
                            {
                                <span class="badge bg-primary">In Progress</span>
                            }
                            else if (complaint.Status == "Done")
                            {
                                <span class="badge bg-success">Done</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- BUTTON MOVED BELOW CARD -->
<div class="submit-btn-below">
    <a asp-action="Submit" class="white-btn">
        <i class="fas fa-plus"></i> Submit New Complaint
    </a>
</div>

<style>
    /* BUTTON BELOW */
    .submit-btn-below {
        margin-top: 20px;
        text-align: center; /* change to right if needed */
    }

    .white-btn {
        background: #ffffff;
        color: #6c63ff; /* purple */
        padding: 10px 20px;
        font-size: 14px;
        border-radius: 10px;
        border: 2px solid #6c63ff;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: 0.3s;
    }

    .white-btn:hover {
        background: #6c63ff;
        color: #ffffff;
    }

    /* EXISTING STYLES */
    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .bg-warning { background: #f59e0b; color: white; }
    .bg-info { background: #3b82f6; color: white; }
    .bg-primary { background: #8b5cf6; color: white; }
    .bg-success { background: #10b981; color: white; }

    .alert-info {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #3b82f6;
        padding: 15px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #10b981;
        padding: 15px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>