@model HostelManagementSystem.Models.Fee

@{
    ViewData["Title"] = "Edit Fee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-card" style="max-width: 600px;">
    <div class="card-header-custom">
        <h4><i class="fas fa-edit"></i> Edit Fee</h4>
    </div>

    <form method="post" asp-controller="Fee" asp-action="Edit">
        @Html.AntiForgeryToken()

        @* ✅ FeeID hidden — needed for WHERE clause *@
        <input type="hidden" asp-for="FeeID" />

        @* ✅ StudentID hidden — never update it *@
        <input type="hidden" asp-for="StudentID" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Month</label>
            <input asp-for="Month" class="form-control" placeholder="e.g. January 2026" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Amount (Rs.)</label>
            <input asp-for="Amount" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Due Date</label>
            <input asp-for="DueDate" type="date" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Status</label>
            <select asp-for="IsPaid" class="form-select">
                <option value="false">Unpaid</option>
                <option value="true">Paid</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-edit">
                <i class="fas fa-save"></i> Update
            </button>
            <a asp-controller="Fee" asp-action="Index" class="btn-view">
                <i class="fas fa-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>