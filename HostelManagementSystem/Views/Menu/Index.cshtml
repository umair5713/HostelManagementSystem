@model IEnumerable<HostelManagementSystem.Models.Menu>

@{
    ViewData["Title"] = "Daily Menus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Daily Menus</h2>
    <a asp-action="AddMenu" class="btn btn-success mb-3">+ Add New Menu</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Breakfast</th>
                <th>Lunch</th>
                <th>Dinner</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Date.ToString("dd/MM/yyyy")</td>
                    <td>@m.Breakfast</td>
                    <td>@m.Lunch</td>
                    <td>@m.Dinner</td>
                    <td>
                        @* ✅ pass id not date *@
                        <a asp-action="EditMenu" asp-route-id="@m.MenuID" class="btn btn-primary btn-sm">Edit</a>

                        @* ✅ Delete must be POST not GET *@
                        <form asp-action="DeleteMenu" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.MenuID" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this menu?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>