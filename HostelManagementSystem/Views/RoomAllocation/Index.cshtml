@model List<HostelManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Room Allocation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allStudents = ViewBag.AllStudents as List<HostelManagementSystem.Models.Student>;
}

<style>
    .dashboard-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin-bottom: 30px;
    }

        .dashboard-card h4 {
            font-weight: 600;
            margin-bottom: 20px;
            color: #333;
        }

    .table thead th {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: white;
        border: none;
    }

    .table tbody tr:hover {
        background-color: #f0f4ff;
        transition: 0.3s;
    }

    .btn-modern {
        border-radius: 50px;
        padding: 8px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-allocate {
        background: #2575fc;
        color: white;
    }

        .btn-allocate:hover {
            background: #6a11cb;
            color: white;
        }

    .btn-deallocate {
        background: #ef4444;
        color: white;
    }

        .btn-deallocate:hover {
            background: #dc2626;
            color: white;
        }

    .page-title {
        text-align: center;
        margin-bottom: 40px;
        font-weight: 600;
        color: #333;
    }

    .room-input {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 6px 10px;
        width: 100px;
        margin-right: 8px;
    }
</style>

<div class="container mt-4">

    <h2 class="page-title">🛏️ Room Allocation</h2>

    <!-- SUCCESS / ERROR MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✔ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">⚠ @TempData["Error"]</div>
    }

    <!-- ALLOCATED ROOMS TABLE -->
    <div class="dashboard-card">
        <h4>🏠 Currently Allocated Rooms</h4>
        <div class="table-responsive">
            <table class="table text-center align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Room No</th>
                        <th>Fee Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.StudentID</td>
                                <td>@s.StudentName</td>
                                <td>@s.RoomNo</td>
                                <td>
                                    @if (s.FeeStatus)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>
                                <td>
                                    <!-- DEALLOCATE -->
                                    <form method="post" asp-action="DeallocateRoom" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="studentId" value="@s.StudentID" />
                                        <button type="submit" class="btn-modern btn-deallocate btn-sm"
                                                onclick="return confirm('Deallocate room for @s.StudentName?')">
                                            ❌ Deallocate
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-muted">No rooms currently allocated.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ALLOCATE ROOM TO STUDENT -->
    <div class="dashboard-card">
        <h4>➕ Allocate Room to Student</h4>
        <div class="table-responsive">
            <table class="table text-center align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Current Room</th>
                        <th>Assign Room</th>
                    </tr>
                </thead>
                <tbody>
                    @if (allStudents != null && allStudents.Count > 0)
                    {
                        @foreach (var s in allStudents)
                        {
                            <tr>
                                <td>@s.StudentID</td>
                                <td>@s.StudentName</td>
                                <td>
                                    @if (string.IsNullOrEmpty(s.RoomNo))
                                    {
                                        <span class="text-muted">Not Assigned</span>
                                    }
                                    else
                                    {
                                        @s.RoomNo
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-action="AllocateRoom" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="studentId" value="@s.StudentID" />
                                        <input type="text" name="roomNo" class="room-input" placeholder="Room No" required />
                                        <button type="submit" class="btn-modern btn-allocate btn-sm">🏠 Allocate</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-muted">No students registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>