@model List<Complaint>
@{
    ViewData["Title"] = "My Complaints";
}

<div class="content-card">
    <div class="card-header-custom">
        <h4><i class="fas fa-clipboard-list"></i> My Complaints</h4>
        <a asp-action="SubmitComplaint" class="btn-primary">
            <i class="fas fa-plus"></i> Submit New Complaint
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-inbox" style="font-size: 64px; color: #cbd5e0; margin-bottom: 20px;"></i>
            <h5>No Complaints Yet</h5>
            <p>You haven't submitted any complaints.</p>
            <a asp-action="SubmitComplaint" class="btn-primary">Submit Your First Complaint</a>
        </div>
    }
    else
    {
        <div class="complaints-grid">
            @foreach (var complaint in Model)
            {
                <div class="complaint-card">
                    <div class="complaint-header">
                        <h5>@complaint.Title</h5>
                        @if (complaint.Status == "Pending")
                        {
                            <span class="status-badge pending">
                                <i class="fas fa-clock"></i> Pending
                            </span>
                        }
                        else if (complaint.Status == "Received")
                        {
                            <span class="status-badge received">
                                <i class="fas fa-check"></i> Received
                            </span>
                        }
                        else if (complaint.Status == "In Progress")
                        {
                            <span class="status-badge progress">
                                <i class="fas fa-spinner"></i> In Progress
                            </span>
                        }
                        else if (complaint.Status == "Done")
                        {
                            <span class="status-badge done">
                                <i class="fas fa-check-circle"></i> Resolved
                            </span>
                        }
                    </div>
                    <p class="complaint-description">@complaint.Description</p>
                    <div class="complaint-footer">
                        <small>
                            <i class="fas fa-calendar"></i>
                            @complaint.Time.ToString("MMM dd, yyyy")
                        </small>
                        <small>
                            <i class="fas fa-clock"></i>
                            @complaint.Time.ToString("hh:mm tt")
                        </small>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .complaints-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .complaint-card {
        background: #f8fafc;
        border: 1px solid rgba(99, 102, 241, 0.12);
        border-radius: 14px;
        padding: 20px;
        transition: all 0.3s;
    }

        .complaint-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(99, 102, 241, 0.15);
        }

    .complaint-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 15px;
    }

        .complaint-header h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
            color: #2d3748;
        }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .status-badge.pending {
            background: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
        }

        .status-badge.received {
            background: rgba(59, 130, 246, 0.15);
            color: #3b82f6;
        }

        .status-badge.progress {
            background: rgba(139, 92, 246, 0.15);
            color: #8b5cf6;
        }

        .status-badge.done {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
        }

    .complaint-description {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 15px;
        line-height: 1.6;
    }

    .complaint-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 15px;
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

        .complaint-footer small {
            color: #94a3b8;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #10b981;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>