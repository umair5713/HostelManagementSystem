@model HostelManagementSystem.Models.Student

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="content-card" style="max-width: 700px; margin: 0 auto;">

    <div style="text-align: center; padding: 30px 0 20px 0;">
        <img src="https://ui-avatars.com/api/?name=@Model.StudentName&background=667eea&color=fff&size=100"
             style="border-radius: 50%; border: 4px solid #667eea; width: 100px; height: 100px;" />
        <h3 style="margin-top: 15px; font-weight: 700; color: #2d3748;">@Model.StudentName</h3>
        <span style="background: linear-gradient(135deg, #667eea, #764ba2);
            color: white; padding: 4px 16px; border-radius: 20px; font-size: 13px;">
            Student
        </span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 20px 0;">

        <div class="profile-info-box">
            <div class="profile-info-icon"><i class="fas fa-id-badge"></i></div>
            <div>
                <span class="profile-info-label">Student ID</span>
                <span class="profile-info-value">@Model.StudentID</span>
            </div>
        </div>

        <div class="profile-info-box">
            <div class="profile-info-icon"><i class="fas fa-envelope"></i></div>
            <div>
                <span class="profile-info-label">Email</span>
                <span class="profile-info-value">@Model.Email</span>
            </div>
        </div>

        <div class="profile-info-box">
            <div class="profile-info-icon"><i class="fas fa-phone"></i></div>
            <div>
                <span class="profile-info-label">Phone Number</span>
                <span class="profile-info-value">@Model.PhoneNumber</span>
            </div>
        </div>

        <div class="profile-info-box">
            <div class="profile-info-icon"><i class="fas fa-credit-card"></i></div>
            <div>
                <span class="profile-info-label">CNIC</span>
                <span class="profile-info-value">@Model.CNIC</span>
            </div>
        </div>

        <div class="profile-info-box">
            <div class="profile-info-icon"><i class="fas fa-book"></i></div>
            <div>
                <span class="profile-info-label">Semester</span>
                <span class="profile-info-value">Semester @Model.Semester</span>
            </div>
        </div>

        <div class="profile-info-box">
            <div class="profile-info-icon"><i class="fas fa-door-open"></i></div>
            <div>
                <span class="profile-info-label">Room Number</span>
                <span class="profile-info-value">
                    @(string.IsNullOrEmpty(Model.RoomNo) ? "Not Assigned" : Model.RoomNo)
                </span>
            </div>
        </div>

        <!-- FEE STATUS FROM ACTUAL FEE RECORDS -->
        <div class="profile-info-box" style="grid-column: span 2;">
            <div class="profile-info-icon"><i class="fas fa-money-bill"></i></div>
            <div>
                <span class="profile-info-label">Fee Status</span>
                @if (ViewBag.HasUnpaid == true)
                {
                    <span class="profile-info-value" style="color: #ef4444; font-weight: 700;">
                        ✘ @ViewBag.UnpaidFees unpaid fee(s) out of @ViewBag.TotalFees
                    </span>
                }
                else if (ViewBag.TotalFees == 0)
                {
                    <span class="profile-info-value" style="color: #f59e0b; font-weight: 700;">
                        ⚠ No fee records found
                    </span>
                }
                else
                {
                    <span class="profile-info-value" style="color: #10b981; font-weight: 700;">
                        ✔ All fees paid (@ViewBag.TotalFees months)
                    </span>
                }
            </div>
        </div>

    </div>
</div>

<style>
    .profile-info-box {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #f8fafc;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid rgba(102, 126, 234, 0.1);
    }

    .profile-info-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 16px;
        flex-shrink: 0;
    }

    .profile-info-label {
        display: block;
        font-size: 11px;
        color: #718096;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .profile-info-value {
        display: block;
        font-size: 15px;
        font-weight: 600;
        color: #2d3748;
    }
</style>