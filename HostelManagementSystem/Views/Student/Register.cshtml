@model HostelManagementSystem.Models.Student

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<style>
    body { background: linear-gradient(135deg, #eef2f3 0%, #8e9eab 100%); min-height: 100vh; }
    .register-card {
        max-width: 600px; margin: auto; border-radius: 20px; padding: 35px;
        background: rgba(255,255,255,0.87); backdrop-filter: blur(10px);
        box-shadow: 0px 10px 25px rgba(0,0,0,0.15); margin-top: 50px; margin-bottom: 50px;
    }
</style>

<div class="register-card">
    <h2 class="text-center fw-bold mb-3">
        <i class="bi bi-person-plus-fill text-primary"></i> Register Student
    </h2>

    <form method="post" action="/Student/Register">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-semibold"><i class="bi bi-person"></i> Student Name</label>
            <input type="text" class="form-control" name="StudentName"
                   placeholder="Enter full name" required />
            <span asp-validation-for="StudentName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold"><i class="bi bi-envelope"></i> Email</label>
            <input type="email" class="form-control" name="Email"
                   placeholder="e.g. student@gmail.com" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold"><i class="bi bi-phone"></i> Phone Number</label>
            <input type="text" class="form-control" name="PhoneNumber"
                   placeholder="e.g. 03001234567" maxlength="11" required />
            <div class="form-text">Must start with 03 followed by 9 digits</div>
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold"><i class="bi bi-credit-card"></i> CNIC</label>
            <input type="text" class="form-control" name="CNIC"
                   placeholder="e.g. 42101-1234567-1" maxlength="15" required />
            <div class="form-text">Format: 42101-1234567-1</div>
            <span asp-validation-for="CNIC" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold"><i class="bi bi-book"></i> Semester</label>
            <select class="form-select" name="Semester" required>
                @for (int i = 1; i <= 8; i++)
                {
                    <option value="@i">Semester @i</option>
                }
            </select>
            <span asp-validation-for="Semester" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold"><i class="bi bi-door-open"></i> Room Number</label>
            <input type="text" class="form-control" name="RoomNo"
                   placeholder="e.g. A-101" maxlength="5" />
            <div class="form-text">Format: A-101 (optional — can be assigned later)</div>
            <span asp-validation-for="RoomNo" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="bi bi-check-circle"></i> Register Student
        </button>
    </form>

    <a href="/Student/Index" class="btn btn-outline-secondary w-100 mt-3">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}