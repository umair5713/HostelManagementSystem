```cshtml
@model HostelManagementSystem.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="dashboard-grid">

    <!-- LEFT COLUMN -->
    <div class="left-column">

        <!-- STUDENT PROFILE CARD -->
        <div class="info-card profile-card">
            <div class="profile-avatar">
                <img src="https://ui-avatars.com/api/?name=@Model.StudentName&background=667eea&color=fff&size=80"
                     alt="Student" />
            </div>
            <div class="profile-info">
                <h3>@Model.StudentName</h3>
                <p class="profile-email"><i class="fas fa-envelope"></i> @Model.Email</p>

                <div class="profile-details">
                    <div class="profile-detail-item">
                        <i class="fas fa-id-card"></i>
                        <span>ID: @Model.StudentID</span>
                    </div>
                    <div class="profile-detail-item">
                        <i class="fas fa-door-open"></i>
                        <span>Room: @Model.RoomNumber</span>
                    </div>
                    <div class="profile-detail-item">
                        <i class="fas fa-calendar-check"></i>
                        <span>Attendance: @Model.AttendancePercent%</span>
                    </div>
                    <div class="profile-detail-item">
                        <i class="fas fa-money-bill"></i>
                        @if (ViewBag.UnpaidFees != null && ViewBag.UnpaidFees > 0)
                        {
                            <span style="color:#ef4444; font-weight:600;">
                                Fee: Rs. @ViewBag.TotalDue due (@ViewBag.UnpaidFees unpaid)
                            </span>
                        }
                        else if (ViewBag.TotalFees == 0)
                        {
                            <span style="color:#f59e0b; font-weight:600;">
                                Fee: No records
                            </span>
                        }
                        else
                        {
                            <span style="color:#10b981; font-weight:600;">
                                Fee: All Paid ✔
                            </span>
                        }
                    </div>
                </div>

                <!-- ATTENDANCE PROGRESS BAR -->
                <div class="attendance-bar-label">
                    <span>Attendance</span>
                    <span>@Model.AttendancePercent%</span>
                </div>
                <div class="attendance-bar">
                    <div class="attendance-fill"
                         style="width: @Model.AttendancePercent%;
                                background: @(Model.AttendancePercent >= 75 ? "#10b981" : Model.AttendancePercent >= 50 ? "#f59e0b" : "#ef4444")">
                    </div>
                </div>
            </div>
        </div>

        <!-- IMPORTANT INFORMATION -->
        <div class="info-card">
            <h5><i class="fas fa-clock"></i> Important Information</h5>
            <div class="info-grid">
                <div class="info-item curfew">
                    <i class="fas fa-moon"></i>
                    <div>
                        <span class="info-label">Curfew Time</span>
                        <span class="info-value">@Model.CurfewTime</span>
                        <span class="info-sub">Please return before this time</span>
                    </div>
                </div>
                <div class="info-item emergency">
                    <i class="fas fa-phone"></i>
                    <div>
                        <span class="info-label">Emergency Contact</span>
                        <span class="info-value">Warden: +92-321-1234567</span>
                        <span class="info-sub">Security: +92-300-9876543</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="info-card">
            <h5><i class="fas fa-bolt"></i> Quick Actions</h5>
            <div class="quick-actions-grid">
                <a href="/Attendance/StudentView" class="quick-action-btn btn-purple">
                    <i class="fas fa-calendar-check"></i>
                    <span>View Attendance</span>
                </a>
                <a href="/Complaints/Submit" class="quick-action-btn btn-pink">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>Lodge Complaint</span>
                </a>
                <a href="/StudentFee/MyFees" class="quick-action-btn btn-cyan">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <span>View Bills</span>
                </a>
                <a href="/StudentMenu/Index" class="quick-action-btn btn-green">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Weekly Menu</span>
                </a>
            </div>
        </div>

    </div>

    <!-- RIGHT COLUMN — TODAY'S MENU -->
    <div class="right-column">
        <div class="info-card">
            <h5><i class="fas fa-utensils"></i> Today's Menu</h5>
            @if (Model.TodaysMenu == null || Model.TodaysMenu.Count == 0)
            {
                <div class="alert-info">No menu available for today.</div>
            }
            else
            {
                @foreach (var item in Model.TodaysMenu)
                {
                    <div class="menu-item">
                        <div class="menu-icon">
                            @if (item.MealType == "Breakfast")
                            {
                                <span>🌅</span>
                            }
                            else if (item.MealType == "Lunch")
                            {
                                <span>🍱</span>
                            }
                            else
                            {
                                <span>🌙</span>
                            }
                        </div>
                        <div class="menu-details">
                            <strong>@item.MealType</strong>
                            <span>@item.Description</span>
                            <small>@item.Time</small>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        padding: 10px;
    }

    .left-column, .right-column {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }

        .info-card h5 {
            font-size: 16px;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 20px;
        }

            .info-card h5 i {
                margin-right: 8px;
                color: #667eea;
            }

    /* PROFILE CARD */
    .profile-card {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .profile-avatar img {
        border-radius: 50%;
        width: 80px;
        height: 80px;
        border: 3px solid #667eea;
    }

    .profile-info {
        flex: 1;
    }

        .profile-info h3 {
            font-size: 20px;
            font-weight: 700;
            color: #2d3748;
            margin: 0 0 4px 0;
        }

    .profile-email {
        color: #667eea;
        font-size: 13px;
        margin-bottom: 12px;
    }

        .profile-email i { margin-right: 5px; }

    .profile-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 15px;
    }

    .profile-detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #4a5568;
    }

        .profile-detail-item i {
            color: #667eea;
            width: 16px;
        }

    /* ATTENDANCE BAR */
    .attendance-bar-label {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 6px;
    }

    .attendance-bar {
        background: #e2e8f0;
        border-radius: 10px;
        height: 10px;
        overflow: hidden;
    }

    .attendance-fill {
        height: 100%;
        border-radius: 10px;
        transition: width 0.5s ease;
    }

    /* INFO GRID */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .info-item {
        border-radius: 12px;
        padding: 15px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

        .info-item i {
            font-size: 20px;
            margin-top: 3px;
        }

    .info-item.curfew {
        background: rgba(239, 68, 68, 0.08);
        border-left: 3px solid #ef4444;
    }

        .info-item.curfew i { color: #ef4444; }

    .info-item.emergency {
        background: rgba(59, 130, 246, 0.08);
        border-left: 3px solid #3b82f6;
    }

        .info-item.emergency i { color: #3b82f6; }

    .info-label {
        display: block;
        font-size: 12px;
        color: #718096;
        font-weight: 600;
        text-transform: uppercase;
    }

    .info-value {
        display: block;
        font-size: 15px;
        font-weight: 700;
        color: #2d3748;
        margin: 3px 0;
    }

    .info-sub {
        display: block;
        font-size: 12px;
        color: #718096;
    }

    /* QUICK ACTIONS */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .quick-action-btn {
        border-radius: 12px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        color: white;
        font-weight: 600;
        font-size: 14px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .quick-action-btn i { font-size: 24px; }

        .quick-action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            color: white;
        }

    .btn-purple { background: linear-gradient(135deg, #667eea, #764ba2); }
    .btn-pink   { background: linear-gradient(135deg, #f093fb, #f5576c); }
    .btn-cyan   { background: linear-gradient(135deg, #4facfe, #00f2fe); }
    .btn-green  { background: linear-gradient(135deg, #43e97b, #38f9d7); }

    /* MENU ITEMS */
    .menu-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .menu-item:last-child { border-bottom: none; }

    .menu-icon {
        font-size: 30px;
        width: 50px;
        text-align: center;
    }

    .menu-details {
        display: flex;
        flex-direction: column;
    }

        .menu-details strong {
            font-size: 15px;
            color: #2d3748;
        }

        .menu-details span {
            font-size: 13px;
            color: #718096;
            margin: 2px 0;
        }

        .menu-details small {
            font-size: 12px;
            color: #a0aec0;
        }

    .alert-info {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #3b82f6;
        padding: 15px;
        border-radius: 10px;
    }
</style>
