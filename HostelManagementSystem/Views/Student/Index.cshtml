@model List<HostelManagementSystem.Models.Student>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <!-- HEADER CARD -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 18px;">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-2">
                <i class="bi bi-people-fill text-primary"></i> Student Management
            </h2>
            <p class="text-muted">View, Register, and Sort Students easily.</p>

            <div class="d-flex gap-2 mt-3">
                <a href="/Student/Register" class="btn btn-success px-4 shadow-sm">
                    <i class="bi bi-person-plus"></i> Add Student
                </a>
                <a href="/Student/SortByID" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-sort-numeric-down"></i> Sort by ID
                </a>
            </div>
        </div>
    </div>

    <!-- STUDENT TABLE -->
    <div class="card shadow-sm border-0" style="border-radius: 18px;">
        <div class="card-body">
            <table class="table table-hover align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-hash"></i> Student ID</th>
                        <th><i class="bi bi-person"></i> Name</th>
                        <th><i class="bi bi-envelope"></i> Email</th>
                        <th><i class="bi bi-phone"></i> Phone</th>
                        <th><i class="bi bi-book"></i> Semester</th>
                        <th><i class="bi bi-door-open"></i> Room No</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold">@s.StudentID</td>
                            <td>@s.StudentName</td>
                            <td>@s.Email</td>
                            <td>@s.PhoneNumber</td>
                            <td>Semester @s.Semester</td>
                            <td>
                                @(string.IsNullOrEmpty(s.RoomNo) ? "Not Assigned" : s.RoomNo)
                            </td>
                            <td>
                                <a asp-controller="Student" asp-action="Details" asp-route-id="@s.StudentID"
                                       class="btn btn-info btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Student" asp-action="Edit" asp-route-id="@s.StudentID"
                                       class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Student" asp-action="Delete" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.StudentID" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Delete @s.StudentName?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>