@model List<HostelManagementSystem.Models.AttendanceRecord>

@{
    ViewBag.Title = "Attendance Records";
}

<h2 class="mt-3">Attendance Records</h2>

<form method="post" asp-action="Mark" class="row g-3 mb-4">
    <div class="col-md-3">
        <input type="text" name="studentId" class="form-control" placeholder="Enter student ID" required />
    </div>
    <div class="col-md-3">
        <input type="text" name="studentName" class="form-control" placeholder="Enter student name" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Mark Attendance</button>
    </div>
</form>



@if (Model == null || Model.Count == 0)
{
    <p>No attendance marked yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Student Name</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.StudentID</td>
                    <td>@record.StudentName</td>
                    <td>@record.Time.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
