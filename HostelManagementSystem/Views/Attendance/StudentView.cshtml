@model List<HostelManagementSystem.Models.AttendanceRecord>
@{
    ViewBag.Title = "My Attendance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="page-title">📋 My Attendance Records</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No attendance records found.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Attendance History</h5>
                <span class="badge bg-success fs-6">
                    Total Present: @Model.Count Days
                </span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-center align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Roll No</th>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }
                            @foreach (var record in Model)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@record.StudentName</td>
                                    <td>@record.StudentID</td>
                                    <td>@record.Time.ToString("dd/MM/yyyy")</td>
                                    <td>@record.Time.ToString("dddd")</td>
                                    <td>@record.Time.ToString("hh:mm tt")</td>
                                    <td>
                                        <span class="badge bg-success">Present</span>
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .page-title {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 600;
        color: #333;
    }
    .card-header {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border-radius: 10px 10px 0 0;
    }
    .table thead th {
        background: #2d3748;
        color: white;
    }
</style>