@model List<HostelManagementSystem.Models.AttendanceRecord>
@{
    ViewBag.Title = "My Attendance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h2 class="mt-3">My Attendance Records</h2>

<form method="get" asp-action="StudentView" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="studentId" class="form-control" placeholder="Enter your Student ID" value="@ViewBag.StudentId" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">View My Attendance</button>
    </div>
</form>

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">@ViewBag.Message</div>
}
else if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">No attendance records found for this Student ID.</div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h5>Attendance for Student ID: @ViewBag.StudentId</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Student Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td>@record.Time.ToString("dd/MM/yyyy")</td>
                            <td>@record.Time.ToString("HH:mm")</td>
                            <td>@record.StudentName</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="mt-3">
                <strong>Total Days Present:</strong> @Model.Count
            </div>
        </div>
    </div>
}
