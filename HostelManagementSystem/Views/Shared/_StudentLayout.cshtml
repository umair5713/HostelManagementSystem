<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMPUS NEST </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Your Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-container">
        <!-- Animated Background -->
        <div class="animated-bg">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>

        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <i class="fas fa-hotel logo-icon"></i>
                    <div>
                        <h2>CAMPUS NEST</h2>
                        <span class="logo-subtitle">User Panel</span>
                    </div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <!-- Dashboard -->
                <a href="/Student/Dashboard" class="nav-item active">
                    <i class="fas fa-chart-line nav-icon"></i>
                    <span>Dashboard</span>
                    <div class="nav-glow"></div>
                </a>

                <!-- Daily Mess / Menu -->
                <a href="/StudentMenu/Index" class="nav-item">
                    <i class="fas fa-utensils nav-icon"></i>
                    <span>Daily Menu</span>
                    <div class="nav-glow"></div>
                </a>

                <!-- Attendance / Meal History -->
                @* <a href="/Attendance/Index" class="nav-item"> *@
                   @* <a asp-controller="Attendance" asp-action="Index" class="nav-link">
                    <i class="fas fa-clipboard-check nav-icon"></i>
                    <span>View Attendance</span>
                    <div class="nav-glow"></div> *@
                </a>

                <a asp-controller="Attendance" asp-action="StudentView" class="nav-item">
                    <i class="fas fa-user-check nav-icon"></i>
                    <span>View My Attendance</span>
                    <div class="nav-glow"></div>
                </a>

               

                <!-- Submit Complaints -->
                <a href="/Complaints/Submit" class="nav-item">
                    <i class="fas fa-exclamation-circle nav-icon"></i>
                    <span>Submit Complaint</span>
                    <div class="nav-glow"></div>
                </a>

                <!-- View My Complaints -->
                <a href="/Complaints/Index" class="nav-item">
                    <i class="fas fa-list-alt nav-icon"></i>
                    <span>My Complaints</span>
                    <div class="nav-glow"></div>
                </a>

                <div class="nav-separator"></div>

                <!-- Logout -->
                <a href="/Auth/Logout" class="nav-item">
                    <i class="fas fa-sign-out-alt nav-icon"></i>
                    <span>Logout</span>
                    <div class="nav-glow"></div>
                </a>
            </nav>

        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Top Header Bar -->
            <header class="top-header">
                <div class="header-left">
                    <h1 class="page-title">
                        <span class="title-gradient">@ViewData["Title"]</span>
                    </h1>
                </div>
                <div class="header-right">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search...">
                    </div>
                    <div class="notification-icon">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </div>
                    <div class="user-profile">
                        <img src="https://ui-avatars.com/api/?name=Admin&background=667eea&color=fff" alt="Admin">
                        <div class="user-details">
                            <span class="user-name">Admin</span>
                            <span class="user-role">Administrator</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content Wrapper -->
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Your Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Add active class to current nav item
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const navItems = document.querySelectorAll('.nav-item');

            navItems.forEach(item => {
                item.classList.remove('active');
                if (item.getAttribute('href') === currentPath) {
                    item.classList.add('active');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>