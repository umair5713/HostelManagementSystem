<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMPUS NEST</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-container">

        <div class="animated-bg">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <i class="fas fa-hotel logo-icon"></i>
                    <div>
                        <h2>CAMPUS NEST</h2>
                        <span class="logo-subtitle">Admin Panel</span>
                    </div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a href="/Admin/Dashboard" class="nav-item">
                    <i class="fas fa-chart-line nav-icon"></i>
                    <span>Dashboard</span>
                    <div class="nav-glow"></div>
                </a>
                <a href="/Student/Register" class="nav-item">
                    <i class="fas fa-user-graduate nav-icon"></i>
                    <span>Students</span>
                    <div class="nav-glow"></div>
                </a>
                <a href="/RoomAllocation/Index" class="nav-item">
                    <i class="fas fa-bed nav-icon"></i>
                    <span>Rooms</span>
                    <div class="nav-glow"></div>
                </a>
                <a href="/Menu/Index" class="nav-item">
                    <i class="fas fa-utensils nav-icon"></i>
                    <span>Mess</span>
                    <div class="nav-glow"></div>
                </a>
                <a href="/Complaints/Admin" class="nav-item">
                    <i class="fas fa-exclamation-circle nav-icon"></i>
                    <span>Complaints</span>
                    <div class="nav-glow"></div>
                </a>
                <a href="/Attendance/Index" class="nav-item">
                    <i class="fas fa-clipboard-check nav-icon"></i>
                    <span>Attendance</span>
                    <div class="nav-glow"></div>
                </a>
                <a href="/Fee/Index" class="nav-item">
                    <i class="fas fa-money-bill-wave nav-icon"></i>
                    <span>Fees</span>
                    <div class="nav-glow"></div>
                </a>

                <div class="nav-separator"></div>

                <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0; padding:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-item logout-btn">
                        <i class="fas fa-sign-out-alt nav-icon"></i>
                        <span>Logout</span>
                        <div class="nav-glow"></div>
                    </button>
                </form>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <header class="top-header">
                <div class="header-left">
                    <h1 class="page-title">
                        <span class="title-gradient">@ViewData["Title"]</span>
                    </h1>
                </div>
                <div class="header-right">
                    
                    <div class="user-profile">
                        <img src="https://ui-avatars.com/api/?name=Admin&background=667eea&color=fff" alt="Admin">
                        <div class="user-details">
                            <span class="user-name">Admin</span>
                            <span class="user-role">Administrator</span>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const currentPath = window.location.pathname;
        const navItems = document.querySelectorAll('.nav-item');
        navItems.forEach(item => {
        item.classList.remove('active');
        if (item.getAttribute('href') === currentPath) {
        item.classList.add('active');
        }
        });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    /* ✅ LOGOUT BUTTON STYLED LIKE NAV ITEM */
    .logout-btn {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    font-family: inherit;
    }

    .logout-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    }

    .logout-btn .nav-icon {
    font-size: 18px;
    width: 20px;
    text-align: center;
    }
</style>